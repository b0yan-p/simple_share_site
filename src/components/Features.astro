---
import { Image } from 'astro:assets';
import tracking from '../assets/illustrations/expense-tracking.png';
import splitting from '../assets/illustrations/shareorb-flexible-splitting.webp';
import debts from '../assets/illustrations/shareorb-simplified-debts.webp';
import offline from '../assets/illustrations/shareorb-offline-mode.webp';
import currency from '../assets/illustrations/shareorb-multi-currency.webp';
import collaboration from '../assets/illustrations/shareorb-effortless-collaboration.webp';
import trackingIcon from '../assets/svg/expense-tracking.svg';
import splittingIcon from '../assets/svg/flexible-splitting.svg';
import debtsIcon from '../assets/svg/simplified-debts.svg';
import offlineIcon from '../assets/svg/offline-mode.svg';
import currencyIcon from '../assets/svg/multi-currency.svg';
import collaborationIcon from '../assets/svg/effortless-collaboration.svg';
import sparkle from '../assets/svg/sparkle.svg';
import underline from '../assets/svg/underline-decoration.svg';

const cards = [
  { label: 'Flexible Splitting', title: 'Split it your way.', description: 'Split an expense equally or choose how much each person owes.', image: splitting, icon: splittingIcon },
  { label: 'Simplified Debts', title: 'Settle up with less hassle.', description: 'Turn on simplified debts to reduce the number of payments your group needs to settle up.', image: debts, icon: debtsIcon, largeArt: true },
  { label: 'Offline Mode', title: 'Works even offline.', description: 'Add expenses without an internet connection. They’ll sync when you’re back online.', image: offline, icon: offlineIcon },
  { label: 'Multi-Currency', title: 'Different currencies, one clear balance.', description: 'Record expenses in different currencies and see the amounts in your group’s currency.', image: currency, icon: currencyIcon },
  { label: 'Effortless Collaboration', title: 'Bring everyone together.', description: 'Invite friends with a link or include them in expenses before they sign up.', image: collaboration, icon: collaborationIcon, wide: true },
];
---

<section id="features" aria-labelledby="features-title">
  <div class="container-shell">
    <header>
      <div>
        <p class="eyebrow">Features</p>
        <h2 id="features-title">More than just<br /> splitting <span>expenses.<img src={underline.src} width="190" height="48" alt="" loading="lazy" /></span></h2>
      </div>
      <p class="lead"><img src={sparkle.src} width="32" height="32" alt="" loading="lazy" />Everything you need to keep shared expenses simple, fair and stress-free.</p>
    </header>

    <div class="cards">
      <article class="tracking">
        <Image class="tracking-art" src={tracking} alt="A hand holding a phone showing a shared trip in ShareOrb" widths={[320, 480, 640, 860, 1086]} sizes="(min-width: 1200px) 420px, (min-width: 640px) 45vw, calc(100vw - 40px)" format="webp" loading="lazy" />
        <div class="tracking-copy">
          <p class="label"><img src={trackingIcon.src} width="36" height="36" alt="" loading="lazy" />Expense Tracking</p>
          <h3>Keep everything in one place.</h3>
          <p>Track shared expenses, see who paid, and check your group balance.</p>
        </div>
      </article>
      {cards.map(card => (
        <article class:list={['card', { wide: card.wide, 'card--large-art': card.largeArt }]}>
          <p class="label"><img src={card.icon.src} width="36" height="36" alt="" loading="lazy" />{card.label}</p>
          <div class="copy">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </div>
          <Image class="art" src={card.image} alt="" widths={[160, 240, 320, 440, card.image.width]} sizes={card.wide ? '(min-width: 640px) 260px, 180px' : card.largeArt ? '220px' : '180px'} loading="lazy" />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 5vw, 5rem);
    color: var(--color-ink);
  }
  header { display: grid; gap: 1.75rem; margin-bottom: 2.5rem; }
  .eyebrow, .label {
    color: var(--color-brand-primary);
    font-weight: 700;
    text-transform: uppercase;
  }
  .eyebrow { font-size: .875rem; margin-bottom: .6rem; }
  h2, h3 { font-weight: 700; letter-spacing: -.035em; line-height: 1.1; }
  h2 { font-size: clamp(1.85rem, 3.4vw, 2.875rem); }
  h2 span { position: relative; display: inline-block; }
  h2 img { position: absolute; width: 145%; max-width: none; bottom: -.34em; left: -3%; z-index: -1; }
  .lead { display: flex; align-items: flex-start; gap: 1rem; padding-left: 1rem; border-left: 2px solid var(--color-brand-tint); color: var(--color-ink-muted); font-size: 1.0625rem; line-height: 1.5; }
  .lead img { flex: none; }
  .cards { display: grid; gap: 1rem; }
  article { min-width: 0; border-radius: var(--radius-showcase); box-shadow: var(--shadow-card); }
  .tracking { overflow: hidden; background: var(--color-brand-primary-hover); color: white; }
  .tracking-art { width: 100%; height: auto; mask-image: linear-gradient(black 70%, transparent); }
  .tracking-copy { position: relative; margin-top: -16%; padding: 0 1.5rem 1.5rem; }
  .tracking .label { color: inherit; }
  .tracking h3 { margin-top: .7rem; max-width: 14ch; font-size: clamp(1.875rem, 2.8vw, 2.5rem); }
  .tracking-copy > p:last-child { margin-top: .8rem; line-height: 1.5; }
  .label { display: flex; align-items: center; gap: .6rem; font-size: .75rem; line-height: 1.3; }
  .label img { flex: none; padding: .45rem; border-radius: .6rem; background: var(--color-brand-lavender); }
  .card { display: grid; align-content: start; gap: .65rem; padding: 1.125rem; background: var(--color-surface-selected); }
  .card h3 { font-size: clamp(1.375rem, 1.65vw, 1.625rem); }
  .copy p { margin-top: .6rem; font-size: 1rem; line-height: 1.4; }
  .art { width: 100%; max-width: 180px; height: auto; align-self: center; justify-self: end; mix-blend-mode: multiply; }
  .card--large-art .art { max-width: 220px; }

  @media (min-width: 640px) {
    header { grid-template-columns: 1fr 1fr; align-items: center; padding-inline: 1rem; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tracking, .wide { grid-column: 1 / -1; }
    .tracking { display: grid; grid-template-columns: 45% 1fr; align-items: center; }
    .tracking-art { max-height: 340px; object-fit: contain; }
    .tracking-copy { margin: 0; padding: 2rem; }
    .wide { grid-template-columns: minmax(0, 1fr) 34%; }
    .wide .art { grid-area: 1 / 2 / span 2; max-width: 260px; }
  }
  @media (min-width: 940px) {
    .card { grid-template-columns: minmax(0, 1fr) 36%; align-content: center; }
    .card--large-art { grid-template-columns: minmax(0, 1fr) 44%; }
    .label { grid-column: 1 / -1; }
    .art { grid-area: 2 / 2; }
    .wide .label { grid-column: 1; }
  }
  @media (min-width: 1200px) {
    header { gap: 3rem; padding-inline: 2rem; margin-bottom: 3rem; }
    .cards { grid-template-columns: minmax(0, 1.15fr) repeat(2, minmax(0, 1fr)); }
    .tracking { position: relative; display: flex; align-items: end; grid-area: 1 / 1 / span 3; }
    .tracking-art { position: absolute; inset: 0; max-height: none; mask-image: linear-gradient(black 52%, transparent 98%); }
    .tracking-copy { padding: 4rem 2rem 2rem; background: linear-gradient(transparent, var(--color-brand-primary-hover) 40%); width: 100%; }
    .wide { grid-column: 2 / -1; }
    .card { padding: 1.125rem 1rem 1.125rem 1.5rem; }
  }
</style>
