---
import { Image } from 'astro:assets';
import mascot from '../assets/brand/logo.png';
---

<header class="absolute inset-x-0 top-0 z-30 border-b border-white/15 bg-transparent">
  <nav
    class="container-shell flex min-h-16 items-center justify-between gap-4 lg:min-h-19"
    aria-label="Main navigation"
  >
    <a
      class="nav-link flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight text-white no-underline"
      href="/"
      aria-label="ShareOrb home"
    >
      <Image
        src={mascot}
        alt=""
        width={48}
        height={38}
        loading="eager"
        class="h-11 w-auto"
      />
      <span>ShareOrb</span>
    </a>

    <!-- Desktop navigation -->
    <div class="hidden items-center gap-3 lg:flex">
      <a
        class="action-link nav-secondary"
        href="#app-preview"
      >
        App preview
      </a>

      <a
        class="action-link nav-primary"
        href="#join-beta"
      >
        Join the Beta
      </a>
    </div>

    <!-- Mobile navigation -->
    <details class="mobile-menu relative lg:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg px-2 text-sm font-medium text-white marker:hidden"
      >
        <span>Menu</span>
        <svg
          class="h-4 w-4 transition-transform"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m3 6 5 5 5-5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </summary>

      <div
        class="absolute right-0 top-full z-20 mt-2 flex w-60 flex-col gap-3 rounded-card border border-brand-lavender-border bg-ink p-4 shadow-raised"
      >
        <a
          class="action-link nav-secondary w-full"
          href="#app-preview"
        >
          App preview
        </a>

        <a
          class="action-link nav-primary w-full"
          href="#join-beta"
        >
          Join the Beta
        </a>
      </div>
    </details>
  </nav>
</header>

<style>
  /* Primary — identical to Hero */
  .nav-primary {
    background: #534ab7;
    color: #ffffff;
    border: 1px solid #d5d1ffad;
    box-shadow: 0 6px 20px rgba(20, 16, 58, 0.22);
    opacity: 1;
    cursor: pointer;
  }

  .nav-primary:hover {
    background: #3c3489;
  }

  /* Secondary — identical to Hero */
  .nav-secondary {
    background: rgba(20, 16, 58, 0.35);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .nav-secondary:hover {
    background: rgba(20, 16, 58, 0.5);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .nav-primary:focus-visible,
  .nav-secondary:focus-visible,
  summary:focus-visible,
  .nav-link:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
</style>